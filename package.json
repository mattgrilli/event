{
  "name": "event-sales-manager",
  "version": "2.0.2",
  "description": "Event & Sales Manager - A professional ticketing and sales management system",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "tickets",
    "event",
    "sales",
    "pta",
    "qr-code",
    "labels"
  ],
  "author": "Matthew Grilli <him@mattgrilli.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "csv-parser": "^3.0.0",
    "csv-stringify": "^6.4.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.mattgrilli.event-sales-manager",
    "productName": "Event & Sales Manager",
    "publish": [
      {
        "provider": "github",
        "owner": "mattgrilli",
        "repo": "event"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "publisherName": "Matthew Grilli"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ]
  }
}
